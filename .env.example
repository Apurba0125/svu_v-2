# ---------------------------------------------------------------------------
# Copy to ".env" and fill in.  NEVER commit the real .env file.
# Generate a key with:  python manage.py generate_secret_key
# ---------------------------------------------------------------------------

DJANGO_SETTINGS_MODULE=svu_site.settings.dev
DJANGO_SECRET_KEY=replace-me-with-a-50-character-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Obscure the admin entry point (do not use "admin/" in production)
DJANGO_ADMIN_URL=manage-svu-a91f/

# --- Database -------------------------------------------------------------
# Leave DB_ENGINE unset to use SQLite (development default).
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=svu
# DB_USER=svu
# DB_PASSWORD=
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_SSLMODE=require

# --- Email (enquiry notifications) ---------------------------------------
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=no-reply@svu.ac.in
ENQUIRY_NOTIFY_EMAILS=admissions@svu.ac.in

# --- Cache (rate limiting + login lockout).  Redis strongly advised in prod.
# REDIS_URL=redis://127.0.0.1:6379/1

# --- HTTPS hardening (production only) -----------------------------------
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_HSTS_SECONDS=31536000
DJANGO_BEHIND_PROXY=True
